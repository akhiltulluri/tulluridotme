# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Personal site of Akhil Tulluri, built with YOCaml"
maintainer: ["Akhil Tulluri"]
authors: ["Akhil Tulluri"]
license: "MIT"
depends: [
  "dune" {>= "3.18"}
  "ocaml" {>= "5.1.1"}
  "yocaml" {>= "3.0.0"}
  "yocaml_unix"
  "yocaml_yaml"
  "yocaml_cmarkit"
  "yocaml_jingoo"
  "yocaml_syndication"
  "cmarkit"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
